# Safe non-secret defaults for local development only.
NODE_ENV=development

# devnet | mainnet. Mainnet additionally requires MAINNET_TRADING_ENABLED=true.
NETWORK=devnet

# paper | live. Paper is the default and never submits transactions.
TRADING_MODE=paper
MAINNET_TRADING_ENABLED=false
# Live mode requires this exact acknowledgement value: I_UNDERSTAND_LIVE_TRADING_IS_UNSAFE
# LIVE_TRADING_ACK=

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8787
SCANNER_INTERVAL_MS=5000
STATE_DIR=.local

# Risk limits (lamports unless noted). The AI/strategy layer may only tighten these.
PAPER_STARTING_BALANCE_LAMPORTS=10000000000
MAX_POSITION_LAMPORTS=300000000
MAX_DAILY_LOSS_LAMPORTS=1000000000
MAX_OPEN_POSITIONS=3
MAX_SLIPPAGE_BPS=100

# Control API is disabled unless explicitly enabled and token-protected.
ENABLE_CONTROL_API=false
# CONTROL_API_TOKEN=

# Browser origins allowed to call the backend (comma-separated, no wildcard).
# Defaults to the loopback dashboard origins when unset. Add your LAN URL for Android.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.20:3000

# Killswitch monitor. The lock file is read by the trader every tick and fails closed.
# KILLSWITCH_STATE_PATH defaults to <STATE_DIR>/killswitch-state.json when unset.
KILLSWITCH_STATE_PATH=.local/killswitch-state.json
KILLSWITCH_HEARTBEAT_PATH=.local/trader-status.json
KILLSWITCH_MAX_STALENESS_MS=30000
KILLSWITCH_INTERVAL_MS=5000

SOLANA_RPC_URL=https://api.devnet.solana.com

# Live mode only: market data feed and mint allowlist. Leave empty for paper mode.
# MARKET_MINTS entries must be valid base58 32-byte Solana addresses; invalid values fail at startup.
# MARKET_DATA_URL=https://example.invalid/market
# MARKET_MINTS=

# PostgreSQL is optional integration infrastructure and is not required for paper mode.
DATABASE_URL=postgresql://trading:trading_dev_only@127.0.0.1:5432/trading

# Frontend (Next.js) build-time backend location. Use your computer's LAN IP for Android.
# NEXT_PUBLIC_BACKEND_URL=http://192.168.1.20:8787

# Do not put private keys, seed phrases, bot tokens, or API secrets in this file.
# Telegram credentials and production signer configuration belong in a secret manager.
